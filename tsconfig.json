{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"types": ["node"],
		"paths": {
			"@components/*": ["./src/components/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@assets/*": ["./src/assets/*"]
		},
		"noImplicitOverride": true,
		"noImplicitReturns": true,
		"noPropertyAccessFromIndexSignature": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	}
}
