    <svg viewBox="0 0 1000 1000" aria-hidden="true" fill="none"><rect width="972" height="972" x="14" y="14" stroke="currentColor" stroke-width="28" rx="186"/><path fill="currentColor" d="M215.347 390.548c-60.463 59.303-60.463 158.441 0 218.904l175.201 175.201c59.303 60.463 158.441 60.463 218.904 0l175.201-175.201c60.463-60.463 60.463-159.601 0-218.904L609.452 215.347c-60.463-60.463-159.601-60.463-218.904 0zm206.657 32.745c42.414-42.672 111.386-43.059 154.058-.644s43.059 111.386.645 154.058c-42.415 42.672-111.386 43.059-154.058.644s-43.059-111.386-.645-154.058"/></svg>
  </a>
