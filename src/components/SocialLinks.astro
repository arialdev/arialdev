  </a>
  <a href={profile.linkedin} aria-label="LinkedIn profile" title="LinkedIn">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><circle cx="5" cy="5" r="2"/><path d="M3 9h4v12H3zM10 9h4v1.7c.7-1.3 1.9-2 3.5-2 3 0 3.5 2.1 3.5 5V21h-4v-6.5c0-1.4-.3-2.5-1.5-2.5-1.3 0-1.5 1.1-1.5 2.5V21h-4z"/></svg>
