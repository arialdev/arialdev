---
import Logo from './Logo.astro';
const links = [
  ['/#home', 'Home'], ['/#about', 'About'], ['/#projects', 'Projects'],
  ['/#contact', 'Contact'],
] as const;
---
<header class="site-header">
  <a href="/#home" class="home-control" aria-label="Álvaro Rivas home" draggable="false"><Logo size={26}/></a>
  <details class="site-menu">
    <summary aria-label="Navigation menu"><span class="menu-lines" aria-hidden="true"></span></summary>
    <nav aria-label="Primary">{links.map(([href, label]) => <a href={href} draggable="false">{label}</a>)}</nav>
  </details>
</header>
<script>
  import '../scripts/navigation';
</script>
