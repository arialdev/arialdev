---
import heroImage from '@assets/images/hero.png';
import { Picture } from 'astro:assets';
import Link from './ui/Link.astro';
---

<section
	data-testid="hero"
	class="flex h-screen flex-col-reverse items-center justify-center text-center lg:flex-row"
>
	<div class="mb-10 flex flex-col items-center lg:mb-0 lg:w-1/2">
		<div>
			<h1 class="mb-10 font-monospace text-3xl text-black dark:text-white lg:text-5xl">
				Hi! My name is <span class="text-orange whitespace-nowrap">Álvaro Rivas</span> and I am a senior
				software engineer based in Madrid.
			</h1>
		</div>
		<div class="mb-10">
			<Link style={'primary'} size={'lg'} class={'flex'} name="learn more" href="#about">
				Learn more
			</Link>
		</div>
	</div>
	<div data-testid="hero-img" class="mb-10 flex w-1/2 items-center justify-center">
		<Picture
			src={heroImage}
			alt="Coding boy"
			sizes="(max-width: 720px) 600px, 1200px"
			widths={[600, 1200]}
			formats={['avif', 'webp']}
			loading="eager"
			width={600}
			height={600}
		/>
	</div>
</section>
