{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error"
	},
	"ignorePatterns": ["dist/**", ".astro/**", "node_modules/**", "test-results/**", "playwright-report/**"],
	"overrides": [
		{
			"files": ["src/env.d.ts"],
			"rules": { "typescript/triple-slash-reference": "off" }
		}
	]
}
